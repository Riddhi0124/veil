# Copy to .env.local and fill in from Firebase console > Project settings > Your apps > Web app.
# These are public client identifiers (not secrets), but App Check must be enforced on your project.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# App Check (required by Firebase AI Logic).
# Production: reCAPTCHA Enterprise site key.
VITE_APPCHECK_SITE_KEY=
# Local dev / judging: a debug token registered in Firebase console > App Check > Apps > Manage debug tokens.
# Leave blank to have the SDK print a fresh token in the browser console on first load.
VITE_APPCHECK_DEBUG_TOKEN=
